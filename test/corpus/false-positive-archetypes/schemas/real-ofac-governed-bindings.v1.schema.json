{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwatchlist.dev/schemas/homelab/real-ofac-governed-bindings.v1.schema.json",
  "title": "OpenWatchlist H1 governed real-source binding set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_set_id",
    "candidate_set_id",
    "candidate_pack_sha256",
    "status",
    "binding_count",
    "partial_acceptance_allowed",
    "accepted_at",
    "set_review",
    "acceptance",
    "bindings",
    "binding_content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "openwatchlist.homelab.real_ofac_governed_bindings.v1"},
    "binding_set_id": {"type": "string", "minLength": 1},
    "candidate_set_id": {"type": "string", "pattern": "^binding_candidates_v2_"},
    "candidate_pack_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "bound"},
    "binding_count": {"const": 35},
    "partial_acceptance_allowed": {"const": false},
    "accepted_at": {"type": "string", "minLength": 1},
    "set_review": {"type": "object"},
    "acceptance": {
      "type": "object",
      "required": ["approver", "approval_statement", "atomic_set_acceptance"],
      "properties": {
        "approver": {"type": "string", "minLength": 2},
        "approval_statement": {"type": "string", "minLength": 20},
        "atomic_set_acceptance": {"const": true}
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 35,
      "maxItems": 35,
      "items": {
        "type": "object",
        "required": [
          "archetype_id",
          "binding_status",
          "candidate_id",
          "ofac_uid",
          "opensanctions_entity_id",
          "exact_mechanic_feature",
          "review",
          "candidate_snapshot_sha256",
          "candidate_snapshot"
        ],
        "properties": {
          "archetype_id": {"type": "string", "pattern": "^fp-[0-9]{3}$"},
          "binding_status": {"const": "bound"},
          "candidate_id": {"type": "string", "minLength": 1},
          "ofac_uid": {"type": "string", "minLength": 1},
          "opensanctions_entity_id": {"type": "string", "minLength": 1},
          "exact_mechanic_feature": {"type": "string", "minLength": 1},
          "review": {
            "type": "object",
            "required": ["reviewer", "reviewed_at", "selection_rationale"],
            "properties": {
              "reviewer": {"type": "string", "minLength": 2},
              "reviewed_at": {"type": "string", "minLength": 1},
              "selection_rationale": {"type": "string", "minLength": 20}
            }
          },
          "candidate_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "candidate_snapshot": {"type": "object"}
        }
      }
    },
    "binding_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
